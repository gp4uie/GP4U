PORT=4000
BASE_URL=http://localhost:4000

# MySQL database connection. Locally, this points at a MySQL server on your own computer.
# On Hostinger, use the host/username/password/database name shown when you create a MySQL
# database in hPanel (Databases > MySQL Databases) — see README for the full walkthrough.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gp4u

# Random long string used to secure the doctor login session. Change this to any random text.
SESSION_SECRET=change-me-to-a-long-random-string

# Practice / doctor details shown on the site, prescriptions, sick certs and referral letters.
PRACTICE_NAME=GP4U
PRACTICE_ADDRESS=Your Practice Address, Town, Co. Dublin
PRACTICE_PHONE=01 234 5678
DOCTOR_NAME=Dr. Your Name
DOCTOR_REG_NUMBER=IMC-000000
DOCTOR_PASSWORD=changeme123
# Where you get emailed when a new booking or patient message comes in. Leave blank to skip
# email alerts and rely on the in-app notification bell on the dashboard only.
DOCTOR_EMAIL=

# Stripe (payments). Leave blank to run in demo mode (bookings auto-confirm, no real payment).
# Get test keys free at https://dashboard.stripe.com/test/apikeys after creating an account.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Email sending for prescriptions/referral letters (e.g. "Send to Pharmacy").
# Leave blank to disable — the dashboard will just show Print/Download instead.
# Once you have a real Healthmail account, its SMTP details go here (ask Healthmail
# support for their SMTP host/port) and everything will send from your real
# @healthmail.ie address over their secure network. Until then, you can use any
# ordinary mailbox's SMTP details (e.g. Gmail with an "app password").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
